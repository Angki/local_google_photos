# ==============================================================================
# Google Photos Local Takeout Gallery - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and update the values according to your system.
#
# Windows example:
# TAKEOUT_DIR=E:\Takeout\Google Photos
#
# Linux / macOS example:
# TAKEOUT_DIR=/home/user/Takeout/Google Photos
# ==============================================================================

# Directory containing your extracted Google Photos Takeout archives
# (e.g. folders like "Photos from 2024", "Photos from 2023", or custom albums)
TAKEOUT_DIR=E:\Takeout\Google Photos

# Server binding host and port
HOST=127.0.0.1
PORT=8000

# Optional: Custom runtime data and thumbnail directory (defaults to ./data)
# DATA_DIR=./data

# Optional: Explicit path to FFmpeg binary for video thumbnail generation
# If not set, the app will search PATH automatically
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
