# Set default behavior to automatically normalize line endings
* text=auto

# Windows batch files must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must use LF
*.sh text eol=lf

# Python, JavaScript, CSS, HTML, Markdown, JSON
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.svg text eol=lf

# Binary files
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
