# ==============================================================================
# Git Ignore - Google Photos Local Takeout Gallery
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Environment Configuration & Secrets
.env
.env.local
.env.*
!.env.example

# ==============================================================================
# Project Runtime Data & User Media (NEVER COMMIT PERSONAL DATA)
# ==============================================================================
photos.db
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Ignore all user data and generated thumbnails inside data/
data/*
!data/.gitkeep
thumbnails/
data/thumbnails/

# OS-generated files
Thumbs.db
Desktop.ini
.DS_Store
*.directory

# Temporary & debug files
*.log
tmp/
temp/
debug_audit.py
test_ok.webp
